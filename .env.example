# Database (Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_v2

# Clerk auth (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# GitHub (for fetching attendee profile data; OAuth handled by Clerk)
GITHUB_TOKEN=

# Anthropic (Claude API for ICP matching)
ANTHROPIC_API_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=events@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Founders Inc / MakerMods event (M1 hardcodes one event)
M1_EVENT_ID=
M1_ADMIN_EMAILS=
